# Environment Variables for Travel Orchestration Platform
# Copy this file to .env and customize values as needed
# This file is committed with placeholders - real secrets go in .env (gitignored)

# ============================================
# Secrets (REQUIRED - no defaults in production)
# ============================================
# JWT secret key - must be at least 512 bits for HS512
JWT_SECRET_KEY=your-super-secret-jwt-key-must-be-at-least-512-bits-long-for-hs512-algorithm

# Stripe secret key - obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ============================================
# PostgreSQL Database Configuration
# ============================================
DB_HOST=postgres_container
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=mypassword

# ============================================
# Neo4j Database Configuration
# ============================================
NEO4J_HOST=neo4j-local
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ============================================
# Rate Limiting Configuration (API Gateway)
# ============================================
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_DURATION=60

# ============================================
# Vault Configuration (disabled by default)
# ============================================
VAULT_ENABLED=false
VAULT_URI=http://localhost:8200
VAULT_TOKEN=your-vault-token
